{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'raster_runtime'",
      "cargo": {
        "args": ["build"],
        "filter": {
          "name": "raster_runtime",
          "kind": "bin"
        }
      },
      "env": {
        "RUST_LOG": "raster_runtime=trace,hyper::http=trace"
      },
      "args": ["index.mjs"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug tests 'raster_runtime'",
      "cargo": {
        "args": ["build"],
        "filter": {
          "name": "raster_runtime",
          "kind": "bin"
        }
      },
      "env": {
        "RUST_LOG": "raster_runtime=trace,hyper::http=trace"
      },
      "args": ["test", "-d", "bundle"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
